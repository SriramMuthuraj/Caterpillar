# Copy to alert/.env and fill in. Never commit the real file.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_TLS=True

# Sending is opt-in. Left unset, EmailClient.send_email builds the message and
# reports {"sent": false, "reason": "dry_run"} without opening a socket, so the
# demo runs offline and no request thread blocks on an SMTP handshake.
ALERTS_ENABLED=false
