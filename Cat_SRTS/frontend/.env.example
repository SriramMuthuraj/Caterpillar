# Copy to .env.local

# VITE_API_BASE_URL: the one backend.
# FastAPI on :8000 serves the forecast and anomaly routes and mounts the Flask
# CRUD app underneath, so every page in the product talks to this single origin.
#
#   uvicorn backend.main:app --port 8000        (run from the repo root)
#
# Point this at http://127.0.0.1:5000 only if you are running the Flask app on
# its own — in that mode the Forecast and Anomaly pages have nothing to call.
VITE_API_BASE_URL="http://127.0.0.1:8000"

# Left over from the AI Studio scaffold. The application code does not read
# either of these.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
